# Placeholder values only. Real values go in user-secrets (local API),
# web/.env.local (local React), or your hosting provider's env settings.
# ASP.NET Core reads nested config keys from env vars using "__" (double underscore).

# ---------- API (ASP.NET Core) ----------
ConnectionStrings__Default=Host=YOUR_HOST;Port=5432;Database=skca_enrol;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require
Jwt__Key=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
Cors__AllowedOrigins__0=https://YOUR-WEB-APP.vercel.app
Seed__Enabled=true
Seed__DemoPassword=REPLACE_WITH_A_DEMO_PASSWORD
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# ---------- React (Vite) ----------
VITE_API_BASE_URL=http://localhost:5056

# ---------- Flutter (passed with --dart-define, not read from this file) ----------
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5056

# ---------- Backend integration tests ----------
# If set, tests use this server instead of starting a Testcontainers postgres.
TEST_DB_CONNECTION=Host=localhost;Port=5432;Username=YOUR_USER;Password=YOUR_PASSWORD
