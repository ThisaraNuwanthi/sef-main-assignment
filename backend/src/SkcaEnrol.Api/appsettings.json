{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "skca-enrol-api",
    "Audience": "skca-enrol-clients",
    "Key": "",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": true,
    "DemoPassword": ""
  },
  "Storage": {
    "UploadsPath": "uploads"
  }
}
